# Loaded by Vite only when the build runs with `--mode development`.
#
# `import.meta.env.DEV` / `PROD` key off NODE_ENV, not off `--mode`, so a
# plain `wxt build --mode development` would still report PROD. Setting
# NODE_ENV here is what makes the DEV guards in src/ (localhost handshake,
# PWA matches, the Chuunime bridge diagnostics) survive into a build you can
# load unpacked. `wxt build` / `wxt zip` never load this file.
NODE_ENV=development
